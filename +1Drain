--==================================================
-- EGG
--==================================================

local EggTab = Window:CreateTab("Egg", 4483362458)

EggTab:CreateSection("Egg Settings")

EggTab:CreateInput({
    Name = "Egg Type",
    CurrentValue = "1",
    PlaceholderText = "1 - 4",
    RemoveTextAfterFocusLost = false,

    Callback = function(Value)

        local Number = tonumber(Value)

        if Number then
            EggType = math.clamp(
                math.floor(Number),
                1,
                4
            )
        end

    end
})

EggTab:CreateInput({
    Name = "Egg Amount",
    CurrentValue = "1",
    PlaceholderText = "Example: 500",
    RemoveTextAfterFocusLost = false,

    Callback = function(Value)

        local Number = tonumber(Value)

        if Number and Number > 0 then
            EggAmount = math.floor(Number)
        end

    end
})

EggTab:CreateToggle({
    Name = "Auto Buy Egg",
    CurrentValue = false,

    Callback = function(Value)
        AutoEgg = Value
    end
})

EggTab:CreateLabel("Egg Type: 1 - 4")

