--==================================================
-- HIDE ALL NOTIFICATIONS
-- Lightweight version
--==================================================

task.spawn(function()

    while task.wait(0.5) do

        if HideNotifications then

            pcall(function()

                local PlayerGui =
                    LocalPlayer:FindFirstChild("PlayerGui")

                if not PlayerGui then
                    return
                end

                for _, Gui in ipairs(
                    PlayerGui:GetChildren()
                ) do

                    local Name =
                        string.lower(Gui.Name)

                    if string.find(
                        Name,
                        "notification",
                        1,
                        true
                    )
                    or string.find(
                        Name,
                        "notif",
                        1,
                        true
                    )
                    or string.find(
                        Name,
                        "toast",
                        1,
                        true
                    )
                    or string.find(
                        Name,
                        "message",
                        1,
                        true
                    )
                    or string.find(
                        Name,
                        "popup",
                        1,
                        true
                    ) then

                        if Gui:IsA("ScreenGui") then
                            Gui.Enabled = false
                        end

                    end

                end

            end)

        end

    end

end)

