--==================================================
-- MISC
--==================================================

local MiscTab = Window:CreateTab("Misc", 4483362458)

MiscTab:CreateSection("Character")

MiscTab:CreateSlider({
    Name = "WalkSpeed",
    Range = {16, 250},
    Increment = 1,
    Suffix = " Speed",
    CurrentValue = 16,

    Callback = function(Value)

        WalkSpeed = Value

        local Character = LocalPlayer.Character

        if Character then

            local Humanoid =
                Character:FindFirstChildOfClass("Humanoid")

            if Humanoid then
                Humanoid.WalkSpeed = Value
            end

        end

    end
})

MiscTab:CreateToggle({
    Name = "Anti AFK",
    CurrentValue = false,

    Callback = function(Value)
        AntiAFK = Value
    end
})

MiscTab:CreateSection("Performance")

MiscTab:CreateToggle({
    Name = "Anti Lag",
    CurrentValue = false,

    Callback = function(Value)

        AntiLag = Value

        if Value then

            for _, Object in ipairs(workspace:GetDescendants()) do

                pcall(function()

                    if Object:IsA("ParticleEmitter")
                    or Object:IsA("Trail")
                    or Object:IsA("Smoke")
                    or Object:IsA("Fire") then

                        Object.Enabled = false

                    elseif Object:IsA("BasePart") then

                        Object.Material =
                            Enum.Material.SmoothPlastic

                    end

                end)

            end

        end

    end
})

MiscTab:CreateToggle({
    Name = "Mute All SFX",
    CurrentValue = false,

    Callback = function(Value)

        MuteSFX = Value

        if Value then

            -- Mute existing sounds
            for _, Object in ipairs(game:GetDescendants()) do

                pcall(function()

                    if Object:IsA("Sound") then
                        Object.Volume = 0
                        Object:Stop()
                    end

                end)

            end

        end

    end
})

MiscTab:CreateSection("Notifications")

MiscTab:CreateToggle({
    Name = "Hide All Notifications",
    CurrentValue = false,

    Callback = function(Value)
        HideNotifications = Value
    end
})

